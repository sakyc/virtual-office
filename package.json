{
  "name": "kantor-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kantor AI - kantor isometrik 3D berisi tim AI untuk digital agency",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"node --watch server/index.js\" \"vite\"",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "migrate:status": "node scripts/migration-status.js",
    "seed:models": "node scripts/seed-model-catalog.mjs",
    "test:model-catalog": "node --test test/model-catalog.test.js",
    "test:model-catalog:local": "node scripts/verify-model-catalog-local.mjs",
    "migrate:apply": "node scripts/migrate.js",
    "migrate:validate": "node scripts/migration-validate.js",
    "migrate:adopt-baseline": "node scripts/migration-adopt-baseline.js",
    "test:migrations": "node --test test/migration-status.test.js test/migration-framework.test.js",
    "test:authorization": "node --test test/tenant-authorization.test.js",
    "test:sessions": "node --test test/sessions.test.js",
    "test:auth0": "node --test test/auth0.test.js",
    "test:native-auth": "node --test test/native-auth.test.js test/auth-flow.test.js",
    "test:profile": "node --test test/profile.test.js",
    "test:members": "node --test test/tenant-members.test.js test/native-auth.test.js test/work-api.test.js test/work-routes.test.js",
    "test:members:local": "node scripts/verify-tenant-members-local.mjs --confirm-non-production",
    "test:dashboard": "node --test test/dashboard-routes.test.js",
    "test:work": "node --test test/work-api.test.js test/work-routes.test.js test/tenant-items.test.js test/tenant-review.test.js test/tenant-jobs.test.js test/dashboard-routes.test.js",
    "test:work:browser": "node --experimental-websocket scripts/verify-tenant-work.mjs",
    "test:tenant-jobs": "node --test test/tenant-jobs.test.js",
    "test:tenant-clients": "node --test test/tenant-clients.test.js",
    "test:tenant-items": "node --test test/tenant-items.test.js",
    "test:office-bridge": "node --test test/office-bridge.test.js",
    "test:office-chat": "node --test test/office-chat.test.js test/office-chat-client.test.js test/office-panel.test.js",
    "test:chat-models": "node --test test/live-chat-models.test.js test/default-model-tariffs.test.js",
    "test:chat-history": "node --test test/chat-history.test.js test/office-chat-client.test.js test/office-panel.test.js",
    "test:chat-history:local": "node scripts/verify-chat-history-local.mjs",
    "test:onboarding": "node --test test/onboarding-routes.test.js",
    "test:tenant-gate": "node --test test/tenant-gate.test.js",
    "test:usage": "node --test test/ai-usage.test.js test/usage-data.test.js test/ai-pricing.test.js",
    "test:billing": "node --test test/billing.test.js test/billing-ui.test.js test/admin-catalog.test.js test/ai-billing.test.js test/billing-administration.test.js test/default-model-tariffs.test.js",
    "test:payments": "node --test test/payments.test.js",
    "test:billing:local": "node scripts/verify-ai-billing-local.mjs",
    "test:billing-admin:local": "node scripts/verify-billing-administration-local.mjs",
    "test:admin": "node --test test/admin-catalog.test.js test/platform-admin.test.js test/admin-dashboard-ui.test.js test/admin-models.test.js",
    "test:admin-models": "node --test test/admin-models.test.js test/billing-administration.test.js test/live-chat-models.test.js test/default-model-tariffs.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "dotenv": "latest",
    "express": "latest",
    "mysql2": "^3.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "latest",
    "umzug": "^3.8.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "latest",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "latest"
  },
  "engines": {
    "node": ">=20"
  }
}
