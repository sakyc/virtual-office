# Salin jadi .env lalu isi. JANGAN commit file .env.

# Wajib untuk mode live. Kosongkan = mode demo (jawaban contoh, gratis).
ANTHROPIC_API_KEY=

# Kode yang harus dimasukkan pengunjung sebelum bisa chat. WAJIB diisi kalau situs publik.
ACCESS_CODE=

PORT=3001
# Deployment behind Apache: HOST=127.0.0.1 and PORT=3101.
# Empty preserves the existing development listen address.
HOST=

# Model: leader pakai yang lebih pintar, anggota tim pakai yang lebih murah.
MODEL_LEADER=claude-sonnet-5-5
MODEL_TEAM=claude-haiku-4-5-20251001

# Optional labels for configured chat defaults; this does NOT register or approve IDs.
# All choices must exist in ai_models with a current seeded/admin billing tariff.
# JSON array: each entry has id, label, costClass (economy/balanced/premium/unspecified).
# Classification is operator guidance, NOT a price or a provider availability guarantee.
# Example syntax only; use IDs actually available to your provider account.
CHAT_MODELS_JSON=[]

# Pengaman biaya
MAX_TOKENS=1500
RATE_PER_MINUTE=15
DAILY_MAX_REQUESTS=300

# Owner-supplied screenshot prices are in shared/ai-model-prices.js (review by 2026-11-24).
# Explicit seed:models binds provider names/limits to API IDs after migration 013.
# Seeder never overwrites existing rows. Runtime prices/status come only from DB.
# Admin tariffs in /admin/models override seeded prices, including disabling them.
# Missing/mismatched/expired prices or a DB error deny AI; no environment fallback.
# Markup remains 2x; request-time FX and tariff version are snapshotted for settlement.
# BILLING_MODEL_RATES_JSON is retained only by isolated test adapters, not app runtime.

# Native login is the default. Apply migration 003 explicitly before registration.
AUTH_PROVIDER=native
APP_ORIGIN=http://localhost:5173

# Optional legacy Auth0 PoC: select AUTH_PROVIDER=auth0 to use it.
AUTH0_ENABLED=0
AUTH0_ISSUER=https://YOUR_TENANT.us.auth0.com
AUTH0_CLIENT_ID=YOUR_CLIENT_ID
AUTH0_CLIENT_SECRET=YOUR_CLIENT_SECRET
AUTH0_CALLBACK_URL=http://localhost:3001/auth/callback
# Generate a random 32+ byte secret. Never commit a real value.
AUTH0_STATE_SECRET=REPLACE_WITH_RANDOM_SECRET
